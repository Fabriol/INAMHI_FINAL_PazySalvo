# Copia este archivo a ".env" en la raíz del proyecto y completa los valores
# reales. El archivo ".env" NUNCA debe subirse a git (ver .gitignore).

# development (DEBUG=True) o production (DEBUG=False, cookies endurecidas)
APP_ENV=production

# Genera una clave nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA

# mysql+pymysql://usuario:contraseña@host/nombre_base_datos
DATABASE_URL=mysql+pymysql://paz_salvo_user:CAMBIA_ESTA_CLAVE@localhost/paz_salvo_db

# true solo si el sitio se sirve por HTTPS (ver comentario en config.py)
SESSION_COOKIE_SECURE=false

# Tamaño máximo de subida en bytes (25 MB por defecto)
MAX_CONTENT_LENGTH=26214400
